{
  "name": "pawnledger",
  "productName": "Pawn Ledger",
  "version": "1.0.0",
  "description": "Pawn Ledger – gold & silver pledge loans, interest, cash & bank, repledges and WhatsApp reminders",
  "author": "Pawn Ledger",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "33.2.0",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.pawnledger.app",
    "productName": "Pawn Ledger",
    "artifactName": "PawnLedger-Setup-${version}.${ext}",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "app/**/*", "build/icon.png", "package.json"],
    "asar": true,
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "icon": "build/icon.png" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pawn Ledger",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    }
  }
}
